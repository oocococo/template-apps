"lvl":2,"unit":6},{"w":"sixteen","p":"/ˌsɪksˈtiːn/","m":"十六","lvl":2,"unit":6},{"w":"eighteen","p":"/ˌeɪˈtiːn/","m":"十八","lvl":2,"unit":6},{"w":"nineteen","p":"/ˌnaɪnˈtiːn/","m":"十九","lvl":2,"unit":6},{"w":"piggy bank","p":"/ˈpɪɡi bæŋk/","m":"*猪形储钱罐","lvl":2,"unit":6},{"w":"pay","p":"/peɪ/","m":"付费","lvl":2,"unit":6},{"w":"back","p":"/bæk/","m":"回到原处","lvl":2,"unit":6}]},"phrases":{"name":"常用表达法","items":[{"en":"Hello! I'm Mike Black.","zh":"你好！我是迈克·布莱克。","unit":1},{"en":"Hi! My name is Wu Binbin.","zh":"嗨！我叫吴斌。","unit":1},{"en":"Nice to meet you.","zh":"见到你很高兴。","unit":1},{"en":"Nice to meet you too.","zh":"你见到你（我）也很高兴。","unit":1},{"en":"Oh no!","zh":"噢，不！","unit":1},{"en":"It's OK, Chen Jie.","zh":"没关系，陈杰。","unit":1},{"en":"Hey, Sarah! We can share.","zh":"嘿，萨拉！我们可以分享。","unit":1},{"en":"Thanks, Sarah. / Thank you, Chen Jie.","zh":"谢，萨拉。/ 谢你，陈杰。","unit":1},{"en":"I am nice to my friends.","zh":"我对我的朋友们很好。","unit":1},{"en":"This is my grandma.","zh":"这是我的奶。","unit":2},{"en":"Look! This is my family.","zh":"看！这是我的家庭。","unit":2},{"en":"Is that your brother?","zh":"那是你弟吗？","unit":2},{"en":"Yes, it is.","zh":"对，是的。","unit":2},{"en":"They love each other.","zh":"他们相互关爱。","unit":2},{"en":"Good morning, Mike!","zh":"早上好，迈克!","unit":3},{"en":"Good morning! Come in.","zh":"早上好! 进来吧。","unit":3},{"en":"Do you have a pet?","zh":"你有宠物吗？","unit":3},{"en":"No, I don't.","zh":"不，我没有。","unit":3},{"en":"Yes, I do. I have a cat.","zh":"是的，我有。我有一只猫。","unit":3},{"en":"Let's go to the zoo!","zh":"我们一起去动物园吧！","unit":3},{"en":"Great!","zh":"太好了！","unit":3},{"en":"What's this?","zh":"这是什么？","unit":3},{"en":"It's a fox.","zh":"是只狐狸。","unit":3},{"en":"Miss White, what's that?","zh":"怀特老师，那是什么？","unit":3},{"en":"It's a red panda.","zh":"是只小熊猫。","unit":3},{"en":"Mike, do you like apples?","zh":"迈克，你喜欢苹果吗？","unit":4},{"en":"Yes, I do. And you?","zh":"是的，我喜欢。你呢？","unit":4},{"en":"No, I don't.","zh":"不，我不喜欢。","unit":4},{"en":"Do you like the farm?","zh":"你们喜欢农场吗？","unit":4},{"en":"I like the fresh air.","zh":"我喜欢新鲜的空气。","unit":4},{"en":"We can plant new trees.","zh":"我们可以新种些树。","unit":4},{"en":"Plants can give us many things.","zh":"植物能提供很多东西。","unit":4},{"en":"What colour is it?","zh":"它是什么颜色？","unit":5},{"en":"It's orange.","zh":"它是橙红色。","unit":5},{"en":"Red and blue make purple.","zh":"红色加蓝色是紫色。","unit":5},{"en":"What colours do you like?","zh":"你喜欢什么颜色？","unit":5},{"en":"I like red and pink.","zh":"我喜欢红色和粉色。","unit":5},{"en":"Let's draw some purple and brown birds.","zh":"我们一起画一些紫色和棕色的鸟吧。","unit":5},{"en":"Use again!","zh":"再次利用！","unit":5},{"en":"How old are you?","zh":"你几岁了？","unit":6},{"en":"I'm five years old.","zh":"我五岁了。","unit":6},{"en":"Me too.","zh":"我也是。","unit":6},{"en":"How many apples?","zh":"几个苹果？","unit":6},{"en":"Two.","zh":"两个。","unit":6},{"en":"That's ten yuan, please.","zh":"（共）十元，谢。","unit":6},{"en":"Here you are.","zh":"给您。","unit":6},{"en":"Happy birthday!","zh":"生日快乐！","unit":6},{"en":"What's your name?","zh":"你叫什么名字？","unit":1},{"en":"My name's Amy Green.","zh":"我叫埃米·格林。","unit":1},{"en":"Where are you from?","zh":"你是哪里人？","unit":1},{"en":"I'm from the UK.","zh":"我是英国人。","unit":1},{"en":"Let me help.","zh":"我来帮忙。","unit":1},{"en":"After you!","zh":"您先请！","unit":1},{"en":"You're welcome.","zh":"别客气。","unit":1},{"en":"Who's that girl?","zh":"那个女孩是谁？","unit":1},{"en":"That's our new neighbour, Amy.","zh":"是我们的新邻居埃米。","unit":1},{"en":"It has a long body and short legs.","zh":"它有长的身体和短的腿。","unit":2},{"en":"Dogs are friendly.","zh":"狗是友善的。","unit":2},{"en":"Do you often say that to your mum?","zh":"你经常对妈那么说吗？","unit":2},{"en":"Yes, I do.","zh":"是的。","unit":2},{"en":"I often make her gifts.","zh":"我经常给她做礼物。","unit":2},{"en":"We express ourselves in many ways.","zh":"我们用很多种方式表达自己。","unit":2},{"en":"Excuse me.","zh":"劳驾。","unit":3},{"en":"Can I use your eraser, please?","zh":"我能用一下你的橡皮吗？","unit":3},{"en":"Sure. Here you are.","zh":"当然。给你。","unit":3},{"en":"No problem.","zh":"没问题。","unit":3},{"en":"What are these?","zh":"这些是什么？","unit":3},{"en":"What about this?","zh":"这个呢？","unit":3},{"en":"I'd like some bread and eggs, please.","zh":"我想吃点儿面包和鸡蛋。","unit":4},{"en":"Have some milk too.","zh":"也喝点儿牛奶吧。","unit":4},{"en":"Would you like some rice and meat?","zh":"要吃点儿米饭和肉吗？","unit":4},{"en":"Yes, please.","zh":"好的，谢。","unit":4},{"en":"Eat some every day!","zh":"每天吃一些吧！","unit":4},{"en":"Do you have old things?","zh":"你有旧东西吗？","unit":5},{"en":"Yes, I do. I have some old books.","zh":"是的。我有些旧书。","unit":5},{"en":"This boat is cool.","zh":"这只船很酷。","unit":5},{"en":"You can keep it.","zh":"你可以留着它。","unit":5},{"en":"Mum, where is my animal book?","zh":"妈，我的动物书在哪儿？","unit":5},{"en":"Is it on the shelf?","zh":"在架子上吗？","unit":5},{"en":"No, it isn't.","zh":"不，不在。","unit":5},{"en":"It's in the box.","zh":"它在盒子里。","unit":5},{"en":"How many books do we have?","zh":"我们有多少本书？","unit":6},{"en":"We have fifteen books.","zh":"我们有十五本书。","unit":6},{"en":"How many boxes do we need?","zh":"我们需要多少个箱子？","unit":6},{"en":"We need three boxes.","zh":"我们需要三个箱子。","unit":6},{"en":"How much is this bag?","zh":"这个包多少钱？","unit":6},{"en":"It's twenty yuan.","zh":"二十元。","unit":6},{"en":"Six yuan, or three for seventeen yuan.","zh":"六元，或者十七元三本。","unit":6},{"en":"How about three for sixteen yuan?","zh":"十六元三本行吗？","unit":6}]}}}