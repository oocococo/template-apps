{"g":2,"vols":[{"vol":"二年级上册","term":1,"kps":[{"id":"2a-p1","type":"poem","sub":"古诗词","name":"梅花","dynasty":"宋","author":"王安石","kind":"poem","lines":["墙角数枝梅，凌寒独自开。","遥知不是雪，为有暗香来。"],"n":5},{"id":"2a-p2","type":"poem","sub":"古诗词","name":"小儿垂钓","dynasty":"唐","author":"胡令能","kind":"poem","lines":["蓬头稚子学垂纶，侧坐莓苔草映身。","路人借问遥招手，怕得鱼惊不应人。"],"n":5},{"id":"2a-p3","type":"poem","sub":"古诗词","name":"江雪","dynasty":"唐","author":"柳宗元","kind":"poem","lines":["千山鸟飞绝，万径人踪灭。","孤舟蓑笠翁，独钓寒江雪。"],"n":5},{"id":"2a-p4","type":"poem","sub":"古诗词","name":"登鹳雀楼","dynasty":"唐","author":"王之涣","kind":"poem","lines":["白日依山尽，黄河入海流。","欲穷千里目，更上一层楼。"],"n":5},{"id":"2a-p5","type":"poem","sub":"古诗词","name":"望庐山瀑布","dynasty":"唐","author":"李白","kind":"poem","lines":["日照香炉生紫烟，遥看瀑布挂前川。","飞流直下三千尺，疑是银河落九天。"],"n":5},{"id":"2a-p6","type":"poem","sub":"古诗词","name":"夜宿山寺","dynasty":"唐","author":"李白","kind":"poem","lines":["危楼高百尺，手可摘星辰。","不敢高声语，恐惊天上人。"],"n":5},{"id":"2a-a1","type":"accum","sub":"日积月累","name":"日积月累","items":[{"cat":"成语","text":"狼吞虎咽"},{"cat":"成语","text":"惊弓之鸟"},{"cat":"成语","text":"胆小如鼠"},{"cat":"成语","text":"龙飞凤舞"},{"cat":"成语","text":"漏网之鱼"},{"cat":"成语","text":"如虎添翼"},{"cat":"成语","text":"鸡鸣狗吠"},{"cat":"成语","text":"害群之马"},{"cat":"成语","text":"如鱼得水"},{"cat":"名言","text":"《论语》与朋友交，言而有信"},{"cat":"名言","text":"《论语》不以规矩，不能成方圆"},{"cat":"名言","text":"《后汉书》志当存高远"},{"cat":"谚语","text":"己所不欲，勿施于人"},{"cat":"谚语","text":"有山皆图画，无水不文章"},{"cat":"谚语","text":"清风明月本无价，近水远山皆有情"},{"cat":"谚语","text":"雾锁山头山锁雾，天连水尾水连天"},{"cat":"谚语","text":"诸葛亮穷且益坚，不坠青云之志"}],"n":7},{"id":"2a-v1","type":"vocab","sub":"词语表","name":"词语表（听写）","words":["看见","哪里","那边","头顶","眼睛","雪白","肚皮","天空","傍晚","人们","冬天","花朵","平常","江河","海洋","田地","工作","办法","如果","已经","长大","海为","家娃","娃只","要皮","毛那","里知","识花","园石","桥队","旗铜","号红","领巾","欢笑","杨树","树叶","枫树","松柏","木棉","水杉","化石","金桂","写字","丛林","深处","竹林","熊猫","朋友","季农","事月","光辛","苦棉","衣同","柱子","边到","底秤","杆力","气出","来船","身石","头地","方果","然评","奖时","间报","纸来","不及","事情","坏事","好事","出国","今天","圆珠","笔开","心以","前还","有台","灯这","时阳","光电","影明","亮故","