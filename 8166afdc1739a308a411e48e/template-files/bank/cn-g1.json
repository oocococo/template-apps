{"g":1,"vols":[{"vol":"一年级上册","term":1,"kps":[{"id":"1a-p1","type":"poem","sub":"古诗词","name":"咏鹅","dynasty":"唐","author":"骆宾王","kind":"poem","lines":["鹅，鹅，鹅，曲项向天歌。","白毛浮绿水，红掌拨清波。"],"n":7},{"id":"1a-p2","type":"poem","sub":"古诗词","name":"江南","dynasty":"汉","author":"乐府","kind":"poem","lines":["江南可采莲，莲叶何田田。","鱼戏莲叶间。","鱼戏莲叶东，鱼戏莲叶西，鱼戏莲叶南，鱼戏莲叶北。"],"n":8},{"id":"1a-p3","type":"poem","sub":"古诗词","name":"画","dynasty":"唐","author":"王维","kind":"poem","lines":["远看山有色，近听水无声。","春去花还在，人来鸟不惊。"],"n":5},{"id":"1a-p4","type":"poem","sub":"古诗词","name":"悯农（其二）","dynasty":"唐","author":"李绅","kind":"poem","lines":["锄禾日当午，汗滴禾下土。","谁知盘中餐，粒粒皆辛苦。"],"n":5},{"id":"1a-p5","type":"poem","sub":"古诗词","name":"古朗月行（节选）","dynasty":"唐","author":"李白","kind":"poem","lines":["小时不识月，呼作白玉盘。","又疑瑶台镜，飞在青云端。"],"n":5},{"id":"1a-p6","type":"poem","sub":"古诗词","name":"风","dynasty":"唐","author":"李峤","kind":"poem","lines":["解落三秋叶，能开二月花。","过江千尺浪，入竹万竿斜。"],"n":5},{"id":"1a-a1","type":"accum","sub":"日积月累","name":"日积月累","items":[{"cat":"成语","text":"三头六臂"},{"cat":"谚语","text":"一寸光阴一寸金，寸金难买寸光阴"},{"cat":"谚语","text":"前面是东，后面是西"},{"cat":"谚语","text":"左面是北，右面是南"},{"cat":"谚语","text":"种瓜得瓜，种豆得豆"},{"cat":"谚语","text":"前人栽树，后人乘凉"},{"cat":"谚语","text":"千里之行，始于足下"},{"cat":"谚语","text":"百尺竿头，更进一步"}],"n":7},{"id":"1a-v2","type":"vocab","sub":"写字表","name":"写字表（听写）","chars":["上","云","雨","虫","山","水","口","耳","目","手","力","男","土","木","心","日","火","田","禾","尺","本","刀","不","少","中","风","立","正","汉","语","拼","音","工","厂","门","卫","王","午","下","月","儿","头","里","见","个","去","在","我","左","右","和","也","又","才","了","子","大","人","爸","妈","可","叶","东","西","比","巴","长","公","竹","马","牙","用","几","只","多","办","石","出","小","鸟","是","天","来","半","你","有","女","开","关","先","牛","羊","爪","白"],"n":94}]},{"vol":"一年级下册","term":2,"kps":[{"id":"1b-p1","type":"poem","sub":"古诗词","name":"春晓","dynasty":"唐","author":"孟浩然","kind":"poem","lines":["春眠不觉晓，处处闻啼鸟。","夜来风雨声，花落知多少。"],"n":5},{"id":"1b-p2","type":"poem","sub":"古诗词","name":"寻隐者不遇","dynasty":"唐","author":"贾岛","kind":"poem","lines":["松下问童子，言师采药去。","只在此山中，云深不知处。"],"n":5},{"id":"1b-p3","type":"poem","sub":"古诗词","name":"赠汪伦","dynasty":"唐","author":"李白","kind":"poem","lines":["李白乘舟将欲行，忽闻岸上踏歌声。","桃花潭水深千尺，不及汪伦送我情。"],"n":5},{"id":"1b-p4","type":"poem","sub":"古诗词","name":"静夜思","dynasty":"唐","author":"李白","kind":"poem","lines":["床前明月光，疑是地上霜。","举头望明月，低头思故乡。"],"n":5},{"id":"1b-p5","type":"poem","sub":"古诗词","name":"人之初","dynasty":"先秦","author":"《三字经》","kind":"poem","lines":["人之初，性本善。性相近，习相远。","苟不教，性乃迁。教之道，贵以专。","子不学，非所宜。幼不学，老何为。","玉不琢，不成器。人不学，不知义。"],"n":17},{"id":"1b-a1","type":"accum","sub":"日积月累","name":"日积月累","items":[{"cat":"名言","text":"《荀子》读万卷书，行万里路"},{"cat":"谚语","text":"有雨山戴帽，无雨半山腰"},{"cat":"谚语","text":"早晨下雨当日晴，晚上下雨到天明"},{"cat":"谚语","text":"蚂蚁搬家蛇过道，大雨不久要来到"},{"cat":"谚语","text":"不知则问，不能则学"},{"cat":"谚语","text":"董其昌读书破万卷，下笔如有神"},{"cat":"谚语","text":"平生不敢轻言语，一叫千门万户开"}],"n":7},{"id":"1b-v2","type":"vocab","sub":"写字表","name":"写字表（听写）","chars":["春","冬","吹","花","飞","入","什","么","古","胡","双","言","青","清","晴","苗","请","生","字","红","动","万","无","明","文","卡","片","合","共","产","党","太","阳","光","井","主","江","住","方","后","告","的","会","北","京","广","写","认","走","河","说","让","自","己","从","好","们","叫","他","回","快","乐","当","书","画","毛","止","斤","寸","丁","千","旦","思","床","前","地","故","乡","色","把","讲","样","笑","再","节","米","间","分","吃","肉","册","支","电","衣","物","造","运","欢","房","网","对","今","雪","细","夕","语","打","皮","跑","足","沙","包","近","习","远","学","玉","义","饱","抱","首","池","采","尖","角","早","眼","泪","它","贝","气","娃","机","台","唱","伞","朵","美","这","看","鱼","面","问","加","豆","斗","笔","知","道","放","平","安","元","灯","车","站","坐","老","师","国","都","百","听","时","点","林","高","兴","着","往","瓜","兔","进","巾","洗","她","空","还","干","身","星","久","吓","为","怕","家","象","没","到","向","边","行","草","赶","过","找","页","户","交","父"],"n":200}]}]}