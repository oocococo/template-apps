{"g":5,"vols":[{"vol":"五年级上册","term":1,"kps":[{"id":"5a-p1","type":"poem","sub":"古诗词","name":"蝉","dynasty":"唐","author":"虞世南","kind":"poem","lines":["垂緌饮清露，流响出疏桐。","居高声自远，非是藉秋风。"],"n":5},{"id":"5a-p2","type":"poem","sub":"古诗词","name":"乞巧","dynasty":"唐","author":"林杰","kind":"poem","lines":["七夕今宵看碧霄，牵牛织女渡河桥。","家家乞巧望秋月，穿尽红丝几万条。"],"n":5},{"id":"5a-p3","type":"poem","sub":"古诗词","name":"渔歌子","dynasty":"唐","author":"张志和","kind":"poem","lines":["西塞山前白鹭飞，桃花流水鳜鱼肥。","青箬笠，绿蓑衣，斜风细雨不须归。"],"n":6},{"id":"5a-p4","type":"poem","sub":"古诗词","name":"观书有感（其一）","dynasty":"宋","author":"朱熹","kind":"poem","lines":["半亩方塘一鉴开，天光云影共徘徊。","问渠那得清如许？为有源头活水来。"],"n":4},{"id":"5a-p5","type":"poem","sub":"古诗词","name":"观书有感（其二）","dynasty":"宋","author":"朱熹","kind":"poem","lines":["昨夜江边春水生，蒙冲巨舰一毛轻。","向来枉费推移力，此日中流自在行。"],"n":5},{"id":"5a-p6","type":"poem","sub":"古诗词","name":"示儿","dynasty":"宋","author":"陆游","kind":"poem","lines":["死去元知万事空，但悲不见九州同。","王师北定中原日，家祭无忘告乃翁。"],"n":5},{"id":"5a-p7","type":"poem","sub":"古诗词","name":"题临安邸","dynasty":"宋","author":"林升","kind":"poem","lines":["山外青山楼外楼，西湖歌舞几时休？","暖风熏得游人醉，直把杭州作汴州。"],"n":4},{"id":"5a-p8","type":"poem","sub":"古诗词","name":"己亥杂诗","dynasty":"清","author":"龚自珍","kind":"poem","lines":["九州生气恃风雷，万马齐喑究可哀。","我劝天公重抖擞，不拘一格降人材。"],"n":5},{"id":"5a-p9","type":"poem","sub":"古诗词","name":"山居秋暝","dynasty":"唐","author":"王维","kind":"poem","lines":["空山新雨后，天气晚来秋。明月松间照，清泉石上流。","竹喧归浣女，莲动下渔舟。随意春芳歇，王孙自可留。"],"n":9},{"id":"5a-p10","type":"poem","sub":"古诗词","name":"枫桥夜泊","dynasty":"唐","author":"张继","kind":"poem","lines":["月落乌啼霜满天，江枫渔火对愁眠。","姑苏城外寒山寺，夜半钟声到客船。"],"n":5},{"id":"5a-p11","type":"poem","sub":"古诗词","name":"长相思","dynasty":"清","author":"纳兰性德","kind":"poem","lines":["山一程，水一程，身向榆关那畔行，夜深千帐灯。","风一更，雪一更，聒碎乡心梦不成，故园无此声。"],"n":9},{"id":"5a-w1","type":"poem","sub":"文言文","name":"少年中国说（节选）","dynasty":"清","author":"梁启超","kind":"prose","lines":["故今日之责任，不在他人，而全在少年。","少年智则国智，少年富则国富，少年强则国强，少年独立则国独立。","美哉，我少年中国，与天不老！壮哉，我中国少年，与国无疆！"],"n":13},{"id":"5a-w2","type":"poem","sub":"文言文","name":"古人谈读书","dynasty":"先秦","author":"《论语》等","kind":"prose","lines":["一、知之为知之，不知为不知，是知也。","二、敏而好学，不耻下问。","三、默而识之，学而不厌，诲人不倦。","四、吾尝终日不食，终夜不寝，以思，无益，不如学也。"],"n":14},{"id":"5a-a1","type":"accum","sub":"日积月累","name":"日积月累","items":[{"cat":"成语","text":"太平盛世"},{"cat":"成语","text":"国泰民安"},{"cat":"成语","text":"丰衣足食"},{"cat":"成语","text":"安居乐业"},{"cat":"成语","text":"政通人和"},{"cat":"成语","text":"人寿年丰"},{"cat":"成语","text":"夜不闭户"},{"cat":"成语","text":"路不拾遗"},{"cat":"成语","text":"多事之秋"},{"cat":"成语","text":"兵荒马乱"},{"cat":"成语","text":"流离失所"},{"cat":"成语","text":"生灵涂炭"},{"cat":"成语","text":"家破人亡"},{"cat":"成语","text":"哀鸿遍野"},{"cat":"成语","text":"民不聊生"},{"cat":"成语","text":"内忧外患"},{"cat":"名言","text":"《尚书》居安思危，戒奢以俭"},{"cat":"谚语","text":"葛洪盛年不重来，一日难再晨"},{"cat":"谚语","text":"及时当勉励，岁月不待人"},{"cat":"谚语","text":"陶渊明莫等闲，白了少年头，空悲切"},{"cat":"谚语","text":"岳飞多少事，从来急；天地转，光阴迫"},{"cat":"谚语","text":"一万年太久，只争朝夕"},{"cat":"谚语","text":"克勤于邦，克俭于家"},{"cat":"谚语","text":"魏征由俭入奢易，由奢入俭难"}],"n":8},{"id":"5a-v1","type":"vocab","sub":"词语表","name":"词语表（听写）","words":["精巧","配合","身段","适宜","白鹤","生硬","寻常","忘却","镜匣","孤独","悠然","嗜好","黄昏","恩惠","美中","不足","播种","浇水","吩咐","榨油","爱慕","体面","桂花","懂得","糕饼","茶叶","汛期","山洪","暴发","间隔","唯独","懒惰","平稳","难免","保持","平衡","协调","美感","示意","家常","假如","理所","当然","联结","无价","之宝","召集","大臣","商议","解决","完好","无缺","称赞","商量","允诺","典礼","承诺","得罪","胆怯","示弱","拒绝","职位","同心","协力","猎豹","冠军","陆地","俯冲","高速","公路","搭乘","火箭","发动","机手","电筒","赤道","难以","置信","侵略","修筑","粉碎","领导","不计","其数","打击","坚持","游击","隐蔽","陷坑","拐弯","无穷","无尽","猎物","酬谢","珍宝","叮嘱","复活","议论","崩塌","焦急","发誓","千真","万确","谎话","迟延","灾难","镇定","后悔","悲痛","震天","动地","嫂子","剩饭","床铺","亲密","笑嘻","嘻成","家立","业好","歹稀","罕妻","子晚","霞辈","子结","婚相","依为","命毁","灭不","可估","量损","失举","世闻","名众","星拱","月金","碧辉","煌殿","堂象","征仿","照诗","情画","意建","筑漫","游天","南海","北饱","览风","景名","胜境","界宏","伟奇","珍异","宝博","物馆","搬运","销毁","罪证","奉命","寸草","不生","摄氏","度繁","殖粮","食煤","炭飘","浮地","区杀","菌治","疗松","鼠乖","巧清","秀玲","珑尾","巴歇","凉追","逐警","觉触","动光","滑狭","窄勉","强脱","落梳","理长","篇连","续广","播铁","路辞","退挣","钱压","抑潮","湿忙","碌阴","暗酷","暑炎","夏噪","声瘦","弱脊","背口","罩忍","心机","械数","落权","利渔","船报","考教","训心","疼席","子庙","会彩","排糖","果抽","象启","迪毕","业寄","宿师","范路","费轮","换领","略意","境磨","灭精","致陆","续白","茫茫","榕树","纠正","不可","计数","照耀","涨潮","树梢","应接","不暇","画眉","舅父","津津","有味","英雄","无限","知半","解述","说厌","烦荒","唐辛","酸访","问书","刊烦","琐真","情实","感质","朴刊"],"n":251},{"id":"5a-v2","type":"vocab","sub":"写字表","name":"写字表（听写）","chars":["宜","鹤","嫌","朱","嵌","框","匣","嗜","哨","恩","韵","亩","播","浇","吩","咐","亭","榨","慕","矮","谈","懂","兰","箩","婆","糕","饼","浸","缠","茶","捡","汛","洪","访","鞋","挽","隔","懒","惰","稳","免","衡","协","绰","召","臣","议","缺","宫","献","诺","典","承","抄","罪","怯","拒","荆","冠","俯","喷","枚","箭","浩","筒","束","赤","圈","置","侵","略","筑","堡","党","丘","妨","蔽","陷","拐","酬","珍","叮","嘱","塌","焦","誓","谎","延","灾","悔","扶","郎","爹","嫂","辆","歹","罕","纱","妻","趟","托","溜","婚","辈","挨","祭","乃","熏","杭","亥","恃","哀","拘","泻","潜","试","胎","皇","履","纵","疆","毁","估","损","拱","辉","煌","殿","陵","览","境","宏","唐","闯","销","奉","摄","氏","殖","粮","炭","区","杀","菌","疗","鼠","秀","玲","珑","帽","尾","歇","窝","滑","拾","狭","勉","梳","辞","抑","碌","吊","酷","暑","噪","脊","罩","竟","哇","忍","械","酸","权","蚕","考","疼","席","糖","屑","迪","钉","陪","毕","煮","枕","孙","泊","愁","寺","畔","桨","榕","纠","耀","桩","涨","塔","梢","暇","眉","抛","耻","诲","谓","诵","岂","舅","津","斩","限","凯","葛","述","贾","衰","统","刊","琐","朴","某"],"n":220}]},{"vol":"五年级下册","term":2,"kps":[{"id":"5b-p1","type":"poem","sub":"古诗词","name":"四时田园杂兴（其三十一）","dynasty":"宋","author":"范成大","kind":"poem","lines":["昼出耘田夜绩麻，村庄儿女各当家。","童孙未解供耕织，也傍桑阴学种瓜。"],"n":5},{"id":"5b-p2","type":"poem","sub":"古诗词","name":"稚子弄冰","dynasty":"宋","author":"杨万里","kind":"poem","lines":["稚子金盆脱晓冰，彩丝穿取当银钲。","敲成玉磬穿林响，忽作玻璃碎地声。"],"n":5},{"id":"5b-p3","type":"poem","sub":"古诗词","name":"村晚","dynasty":"宋","author":"雷震","kind":"poem","lines":["草满池塘水满陂，山衔落日浸寒漪。","牧童归去横牛背，短笛无腔信口吹。"],"n":5},{"id":"5b-p4","type":"poem","sub":"古诗词","name":"游子吟","dynasty":"唐","author":"孟郊","kind":"poem","lines":["慈母手中线，游子身上衣。","临行密密缝，意恐迟迟归。谁言寸草心，报得三春晖。"],"n":7},{"id":"5b-p5","type":"poem","sub":"古诗词","name":"鸟鸣涧","dynasty":"唐","author":"王维","kind":"poem","lines":["人闲桂花落，夜静春山空。","月出惊山鸟，时鸣春涧中。"],"n":5},{"id":"5b-p6","type":"poem","sub":"古诗词","name":"凉州词","dynasty":"唐","author":"王之涣","kind":"poem","lines":["黄河远上白云间，一片孤城万仞山。","羌笛何须怨杨柳，春风不度玉门关。"],"n":5},{"id":"5b-p7","type":"poem","sub":"古诗词","name":"黄鹤楼送孟浩然之广陵","dynasty":"唐","author":"李白","kind":"poem","lines":["故人西辞黄鹤楼，烟花三月下扬州。","孤帆远影碧空尽，唯见长江天际流。"],"n":5},{"id":"5b-p8","type":"poem","sub":"古诗词","name":"乡村四月","dynasty":"宋","author":"翁卷","kind":"poem","lines":["绿遍山原白满川，子规声里雨如烟。","乡村四月闲人少，才了蚕桑又插田。"],"n":5},{"id":"5b-p9","type":"poem","sub":"古诗词","name":"从军行","dynasty":"唐","author":"王昌龄","kind":"poem","lines":["青海长云暗雪山，孤城遥望玉门关。","黄沙百战穿金甲，不破楼兰终不还。"],"n":5},{"id":"5b-p10","type":"poem","sub":"古诗词","name":"秋夜将晓出篱门迎凉有感","dynasty":"宋","author":"陆游","kind":"poem","lines":["三万里河东入海，五千仞岳上摩天。","遗民泪尽胡尘里，南望王师又一年。"],"n":5},{"id":"5b-p11","type":"poem","sub":"古诗词","name":"闻官军收河南河北","dynasty":"唐","author":"杜甫","kind":"poem","lines":["剑外忽传收蓟北，初闻涕泪满衣裳。","却看妻子愁何在，漫卷诗书喜欲狂。","白日放歌须纵酒，青春作伴好还乡。","即从巴峡穿巫峡，便下襄阳向洛阳。"],"n":9},{"id":"5b-w1","type":"poem","sub":"文言文","name":"杨氏之子","dynasty":"南朝","author":"《世说新语》","kind":"prose","lines":["梁国杨氏子九岁，甚聪惠。","孔君平诣其父，父不在，乃呼儿出。为设果，果有杨梅。","孔指以示儿曰：'此是君家果。'儿应声答曰：'未闻孔雀是夫子家禽。'"],"n":11},{"id":"5b-a1","type":"accum","sub":"日积月累","name":"日积月累","items":[{"cat":"成语","text":"相貌堂堂"},{"cat":"名言","text":"《论语》君子坦荡荡，小人长戚戚"},{"cat":"名言","text":"《论语》恻隐之心，仁之端也"},{"cat":"名言","text":"《孟子》多行不义，必自毙"},{"cat":"名言","text":"《左传》人有耻，则能有所不为"},{"cat":"名言","text":"《朱子语类》"},{"cat":"谚语","text":"君子喻于义，小人喻于利"}],"n":5},{"id":"5b-v1","type":"vocab","sub":"词语表","name":"词语表（听写）","words":["蝴蝶","蜻蜓","蚂蚱","圆滚","滚明","晃晃","樱桃","榆树","瞎闹","锄头","承认","随意","妒忌","委托","照办","预计","紧急","军令","状探","听疑","惑私","自布","置调","度呐","喊神","机妙","算半","夜更","寻思","耻笑","胸膛","武艺","拟定","参谋","损失","锻炼","情不","自禁","慰问","眷恋","奔赴","繁忙","特殊","尊重","签字","下意","识踌","躇诊","所年","龄熟","练审","视针","见血","施行","清醒","颤抖","声不","吭崭","新由","衷苍","白慈","祥肃","然起","敬荣","幸摔","跤手","疾眼","快欺","负脚","腕子","挺脱","肢体","格局","威严","侄子","喉咙","粉刷","师傅","绝活","派头","包袱","手法","鼓点","衔接","屏障","芝麻","神圣","侵犯","露馅","儿轰"